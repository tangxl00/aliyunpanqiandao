# 阿里云盘 refresh_token（必填）
# 获取方法见 CREDENTIALS.md；多账号用 & 或换行分隔
REFRESH_TOKEN=your_refresh_token_here

# 只查询不签到（可选，1=开启，默认 0）
DRY_RUN=0

# ===== 消息推送渠道（全部可选，按需填写）=====
# Server 酱（微信）
SERVERCHAN_SCKEY=
# PushPlus（微信）
PUSHPLUS_TOKEN=
# 钉钉群机器人 Webhook
DINGTALK_WEBHOOK=
# 企业微信群机器人 Webhook
WECHAT_WEBHOOK=
# Telegram Bot Token
TELEGRAM_BOT_TOKEN=
# Telegram Chat ID
TELEGRAM_CHAT_ID=
# Bark（iOS）
BARK_URL=
